// Live wire item census: run with -auto -addr <relay> -proto <id>.
// No join line here: -auto performs the join with the -proto flag, so the
// same script works unchanged for 1001/2168/2169/2193.
{"cmd":"wait","ms":2000}
{"cmd":"assert","metric":"spawned","op":"==","value":true}
{"cmd":"assert","metric":"game_data_items","op":">","value":0}
{"cmd":"assert","metric":"packet_LevelChunk","op":">","value":0}
{"cmd":"assert","metric":"decode_errors","op":"==","value":0}
{"cmd":"assert","metric":"items_visible","op":">","value":0}
{"cmd":"assert","metric":"items_lost","op":"==","value":0}
{"cmd":"assert","metric":"items_unknown","op":"==","value":0}
{"cmd":"look","yaw":0.5,"pitch":0.1}
{"cmd":"chat","message":"clientclone item census"}
{"cmd":"hotbar","slot":1}
{"cmd":"wait","ms":1500}
{"cmd":"assert","metric":"auth_input","op":">","value":0}
{"cmd":"dump"}
{"cmd":"quit"}
